# Copy these values into the deployment platform's secret manager. Do not
# commit a populated .env.staging file.
VIRECTOR_ENVIRONMENT=staging
VIRECTOR_STORAGE_BACKEND=s3
VIRECTOR_JOB_REPOSITORY_BACKEND=postgres
VIRECTOR_S3_ENDPOINT_URL=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
VIRECTOR_S3_REGION=auto
VIRECTOR_S3_BUCKET=virector-staging
VIRECTOR_S3_KEY_PREFIX=virector-staging
VIRECTOR_S3_ACCESS_KEY_ID=replace-in-secret-manager
VIRECTOR_S3_SECRET_ACCESS_KEY=replace-in-secret-manager
VIRECTOR_S3_PRESIGNED_URL_TTL_SECONDS=900

VIRECTOR_DATABASE_URL=postgresql://replace-with-supabase-pooler-url
VIRECTOR_DATABASE_POOL_MIN_SIZE=1
VIRECTOR_DATABASE_POOL_MAX_SIZE=5
VIRECTOR_DATABASE_POOL_TIMEOUT_SECONDS=10
VIRECTOR_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
VIRECTOR_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VIRECTOR_SUPABASE_JWT_AUDIENCE=authenticated
VIRECTOR_AUTH_REQUIRED=true

# Build-time public values for the Next.js client. Never place a secret or
# service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

VIRECTOR_WORKER_MODE=mock
VIRECTOR_PERFORMANCE_SEGMENT_WORKER=vace
VIRECTOR_PERFORMANCE_MOTION_BACKEND=disabled
VIRECTOR_PERFORMANCE_SPEECH_BACKEND=disabled
VIRECTOR_PERFORMANCE_AUDIO_BACKEND=disabled
VIRECTOR_CORS_ORIGINS=https://staging.virector.example.com
VIRECTOR_HOST=0.0.0.0
VIRECTOR_PORT=8000
