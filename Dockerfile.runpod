FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ARG WAN2_COMMIT=42bf4cfaa384bc21833865abc2f9e6c0e67233dc

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRECTOR_DATA_DIR=/runpod-volume/virector \
    VIRECTOR_MODELS_DIR=/runpod-volume/virector/models \
    VIRECTOR_CACHE_DIR=/runpod-volume/virector/cache \
    VIRECTOR_OUTPUTS_DIR=/runpod-volume/virector/outputs \
    VIRECTOR_WORKER_MODE=performance \
    VIRECTOR_PERFORMANCE_SEGMENT_WORKER=vace \
    VIRECTOR_PERFORMANCE_MOTION_BACKEND=wan-animate \
    VIRECTOR_VACE_ALLOW_DOWNLOAD=true \
    VIRECTOR_WAN_ANIMATE_REPO_DIR=/opt/Wan2.2 \
    VIRECTOR_WAN_ANIMATE_PYTHON=/opt/wan-animate-venv/bin/python \
    VIRECTOR_WAN_ANIMATE_CHECKPOINT_DIR=/runpod-volume/virector/models/Wan2.2-Animate-14B \
    VIRECTOR_WAN_ANIMATE_ALLOW_DOWNLOAD=true \
    HF_HOME=/runpod-volume/virector/cache/huggingface \
    TORCH_HOME=/runpod-volume/virector/cache/torch \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_DISABLE_SYMLINKS_WARNING=1 \
    MAX_JOBS=2 \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0+PTX"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        git \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        build-essential \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Wan2.2-Animate is isolated because its official dependency bounds conflict
# with the lightweight LTX/VACE application environment.
RUN git clone https://github.com/Wan-Video/Wan2.2.git /opt/Wan2.2 && \
    cd /opt/Wan2.2 && git checkout "$WAN2_COMMIT" && \
    python3 -m venv /opt/wan-animate-venv && \
    /opt/wan-animate-venv/bin/python -m pip install --upgrade \
        pip setuptools wheel packaging ninja && \
    /opt/wan-animate-venv/bin/python -m pip install \
        torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 \
        --index-url https://download.pytorch.org/whl/cu128 && \
    sed '/^flash_attn$/d' requirements.txt > /tmp/wan-requirements.txt && \
    sed '/facebookresearch\/sam2/d' requirements_animate.txt \
        > /tmp/wan-animate-requirements.txt && \
    /opt/wan-animate-venv/bin/python -m pip install \
        -r /tmp/wan-requirements.txt \
        -r /tmp/wan-animate-requirements.txt && \
    /opt/wan-animate-venv/bin/python -m pip install \
        --no-build-isolation \
        -e "git+https://github.com/facebookresearch/sam2.git@0e78a118995e66bb27d78518c4bd9a3e95b4e266#egg=SAM-2" && \
    /opt/wan-animate-venv/bin/python -m pip install \
        flash-attn --no-build-isolation && \
    rm -rf /root/.cache/pip \
        /tmp/wan-requirements.txt \
        /tmp/wan-animate-requirements.txt

WORKDIR /app

COPY pyproject.toml README.md ./
RUN mkdir -p virector && touch virector/__init__.py && \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        torch==2.11.0 torchvision==0.26.0 \
        --index-url https://download.pytorch.org/whl/cu128 && \
    python3 -m pip install ".[ltx,runpod]" && \
    python3 -c "import ftfy, torch; assert torch.version.cuda == '12.8', torch.version.cuda" && \
    rm -rf virector

COPY virector ./virector

CMD ["python3", "-u", "-m", "virector.runpod_handler"]
