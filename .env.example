VIRECTOR_DATA_DIR=/data
VIRECTOR_ENVIRONMENT=local
VIRECTOR_STORAGE_BACKEND=local
VIRECTOR_MODELS_DIR=/data/models
VIRECTOR_CACHE_DIR=/data/cache
VIRECTOR_OUTPUTS_DIR=/data/outputs

# S3-compatible storage (Cloudflare R2 in staging/production).
# Leave these unset while VIRECTOR_STORAGE_BACKEND=local.
VIRECTOR_S3_ENDPOINT_URL=
VIRECTOR_S3_REGION=auto
VIRECTOR_S3_BUCKET=
VIRECTOR_S3_KEY_PREFIX=virector
VIRECTOR_S3_ACCESS_KEY_ID=
VIRECTOR_S3_SECRET_ACCESS_KEY=
VIRECTOR_S3_PRESIGNED_URL_TTL_SECONDS=900

# Reserved for the upcoming Supabase-backed job repository.
VIRECTOR_DATABASE_URL=
VIRECTOR_SUPABASE_URL=

# Host bind mounts used by Docker Compose.
VIRECTOR_HOST_MODELS_DIR=E:/Virector/models
VIRECTOR_HOST_CACHE_DIR=E:/Virector/cache
VIRECTOR_HOST_OUTPUTS_DIR=E:/Virector/outputs
VIRECTOR_HOST_UPLOADS_DIR=E:/Virector/uploads

# Build the optional CUDA/PyTorch/Diffusers runtime into the Docker image.
VIRECTOR_INSTALL_LTX=0

# Set to vace for the self-hosted multi-reference worker. Until that runtime is
# installed, Virector falls back to LTX and then mock while reporting why.
VIRECTOR_WORKER_MODE=mock
VIRECTOR_VACE_MODEL_NAME=Wan2.1-VACE-1.3B
VIRECTOR_VACE_MODEL_REPO=Wan-AI/Wan2.1-VACE-1.3B-diffusers
VIRECTOR_VACE_REPO_DIR=/data/models/VACE
VIRECTOR_VACE_CHECKPOINT_DIR=/data/models/Wan2.1-VACE-1.3B-diffusers
VIRECTOR_VACE_INFERENCE_STEPS=8
VIRECTOR_VACE_GUIDANCE_SCALE=5.0
VIRECTOR_VACE_FPS=16
VIRECTOR_VACE_MAX_FRAMES=81
VIRECTOR_VACE_QUANTIZE_4BIT=true
VIRECTOR_VACE_CPU_OFFLOAD=true
# Keep automatic 19GB model downloads disabled. Use vace_preflight --download.
VIRECTOR_VACE_ALLOW_DOWNLOAD=false
VIRECTOR_VACE_IGNORE_PREFLIGHT=false

# Comma-separated production frontend origins may be added here.
VIRECTOR_CORS_ORIGINS=http://localhost:3000
VIRECTOR_LTX_MODEL_REPO=Lightricks/LTX-Video
VIRECTOR_LTX_CHECKPOINT_FILENAME=ltxv-2b-0.9.8-distilled.safetensors
VIRECTOR_LTX_INFERENCE_STEPS=8
VIRECTOR_LTX_MAX_FRAMES=97
VIRECTOR_LTX_TEXT_ENCODER_4BIT=true
VIRECTOR_LTX_CPU_OFFLOAD=true
VIRECTOR_HOST=0.0.0.0
VIRECTOR_PORT=8000
