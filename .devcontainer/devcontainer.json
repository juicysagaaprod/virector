{
  "name": "Virector Studio Preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "containerEnv": {
    "VIRECTOR_WORKER_MODE": "mock",
    "VIRECTOR_DATA_DIR": "${containerWorkspaceFolder}/data"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Virector Web",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "8000": {
      "label": "Virector API",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]' && npm --prefix web ci",
  "postStartCommand": "bash .devcontainer/start-virector.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
